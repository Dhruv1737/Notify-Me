// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())
  sessions     Session[]
  emailTokens  EmailToken[]
  watches      Watch[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



  enum WatchStatus {
  PENDING
  ACTIVE
  ERROR
  PAUSED
}

enum AlertMode {
  PAGE_CHANGES
  NEW_LINE_KEYWORDS
  KEYWORDS_APPEAR
  KEYWORDS_DISAPPEAR
}

enum MatchMode {
  ANY
  ALL
}

model Watch {
  id              String      @id @default(cuid())
  userId          String
  url             String
  name            String?
  selector        String?
  intervalMinutes Int         @default(60)
  status          WatchStatus @default(PENDING)

  alertsEnabled   Boolean     @default(true)
  alertMode       AlertMode   @default(PAGE_CHANGES)
  keywords        String[]
  matchMode       MatchMode   @default(ANY)
  keywordState    Boolean?

  failureCount    Int         @default(0)
  lastError       String?
  warning         String?
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime    @default(now())
  lastChangedAt   DateTime?
  lastAlertAt     DateTime?
  errorNotifiedAt DateTime?
  lockedUntil     DateTime?
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots       Snapshot[]
  changes         Change[]
  checkLogs       CheckLog[]

  @@index([userId])
  @@index([status, nextCheckAt])
}


model Snapshot {
  id          String   @id @default(cuid())
  watchId     String
  content     String
  hash        String
  createdAt   DateTime @default(now())

  watch       Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  changesFrom Change[] @relation("ChangeFrom")
  changesTo   Change[] @relation("ChangeTo")

  @@index([watchId, createdAt])
}

model Change {
  id              String    @id @default(cuid())
  watchId         String
  fromSnapshotId  String?
  toSnapshotId    String?
  added           String[]
  removed         String[]
  truncated       Boolean   @default(false)
  alertable       Boolean   @default(false)
  matchedKeywords String[]
  matchedLines    String[]
  emailedAt       DateTime?
  createdAt       DateTime  @default(now())

  watch           Watch     @relation(fields: [watchId], references: [id], onDelete: Cascade)
  fromSnapshot    Snapshot? @relation("ChangeFrom", fields: [fromSnapshotId], references: [id], onDelete: SetNull)
  toSnapshot      Snapshot? @relation("ChangeTo", fields: [toSnapshotId], references: [id], onDelete: SetNull)

  @@index([watchId, createdAt])
}

model CheckLog {
  id         String   @id @default(cuid())
  watchId    String
  checkedAt  DateTime @default(now())
  success    Boolean
  statusCode Int?
  durationMs Int
  changed    Boolean  @default(false)
  error      String?

  watch      Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId, checkedAt])
  @@index([checkedAt])
}